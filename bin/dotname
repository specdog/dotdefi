#!/usr/bin/env node
// dotname — spec-first onchain identity
import { readFileSync, writeFileSync, mkdirSync, existsSync } from 'fs';
import { join } from 'path';

const cmd = process.argv[2];
const arg = process.argv[3] || '';

const PROP_MAP = {
  's': 'string', 's!': 'string', 'n': 'uint256', 'n!': 'uint256',
  'b': 'bool', 'b!': 'bool', 'e': 'uint8', 'e!': 'uint8',
  'j': 'string', 'j!': 'string',
};

function toPascalCase(s) {
  return s.replace(/[-_\s]+(.)?/g, (_, c) => c ? c.toUpperCase() : '').replace(/^./, c => c.toUpperCase());
}

function toCamelCase(s) {
  return s.replace(/[-_\s]+(.)?/g, (_, c) => c ? c.toUpperCase() : '').replace(/^./, c => c.toLowerCase());
}

function decodeProp(enc) { return PROP_MAP[enc] || 'string'; }

function generateContract(node, edges) {
  const name = toPascalCase(node.i);
  let code = `// SPDX-License-Identifier: MIT
// Generated by dotname from .dog spec — ${node.d}
pragma solidity ^0.8.20;\n\n`;
  
  code += `import {Ownable} from "@openzeppelin/contracts/access/Ownable.sol";\n\n`;
  
  if (node.s.length > 0)
    code += `enum ${name}State { ${node.s.map(s => toPascalCase(s)).join(', ')} }\n\n`;
  if (node.s.length > 0)
    code += `event StateChanged(${name}State from, ${name}State to);\n\n`;
  
  code += `contract ${name} is Ownable {\n`;
  
  for (const [propName, enc] of Object.entries(node.p))
    code += `    ${decodeProp(enc)} public ${toCamelCase(propName)};\n`;
  
  if (node.s.length > 0)
    code += `\n    ${name}State public state;\n`;
  
  code += `\n    constructor() Ownable(msg.sender) {\n`;
  if (node.s.length > 0) code += `        state = ${name}State.${toPascalCase(node.s[0])};\n`;
  code += `    }\n\n`;
  
  for (const t of node.l) {
    const [from, to] = t.split(/\s*→\s*/);
    if (!from || !to) continue;
    code += `    function ${toCamelCase(to)}() external onlyOwner {\n`;
    code += `        require(state == ${name}State.${toPascalCase(from)}, "Invalid state");\n`;
    code += `        ${name}State _prev = state;\n`;
    code += `        state = ${name}State.${toPascalCase(to)};\n`;
    code += `        emit StateChanged(_prev, state);\n    }\n\n`;
  }
  
  for (const e of edges.filter(e => e.s === node.i)) {
    code += `    // ${e.v} → ${e.t}\n`;
    code += `    address public ${toCamelCase(e.t)}Contract;\n\n`;
  }
  
  code += `}\n`;
  return code;
}

function generate(dir, project) {
  const dagFile = join(dir, 'specs', project, `${project}.dag`);
  if (!existsSync(dagFile)) throw new Error('No .dag found. Run dotdog compile first.');
  
  const dag = JSON.parse(readFileSync(dagFile, 'utf-8'));
  const nodes = dag.n || [];
  const edges = dag.e || [];
  const outDir = join(dir, 'contracts', 'src');
  mkdirSync(outDir, { recursive: true });
  
  const files = [];
  for (const node of nodes) {
    if (node.t === 'contract' || node.g === 'contract') {
      const code = generateContract(node, edges);
      const fileName = `${toPascalCase(node.i)}.sol`;
      writeFileSync(join(outDir, fileName), code, 'utf-8');
      files.push(fileName);
    }
  }
  
  // Deploy script
  let deployScript = `// Deploy script for ${project} on Base Sepolia
const { ethers } = require("hardhat");

async function main() {
  const [deployer] = await ethers.getSigners();
  console.log("Deploying from:", deployer.address);\n\n`;
  
  for (const node of nodes) {
    if (node.t === 'contract' || node.g === 'contract') {
      const n = toPascalCase(node.i);
      deployScript += `  const ${toCamelCase(node.i)} = await ethers.deployContract("${n}");\n`;
      deployScript += `  await ${toCamelCase(node.i)}.waitForDeployment();\n`;
      deployScript += `  console.log("${n}:", await ${toCamelCase(node.i)}.getAddress());\n\n`;
    }
  }
  deployScript += `}\n\nmain().catch(console.error);\n`;
  writeFileSync(join(dir, 'contracts', 'deploy.js'), deployScript, 'utf-8');
  
  return { files, output: outDir };
}

switch (cmd) {
  case 'generate': {
    console.log('  dotname generate\n');
    const r = generate('.', 'yield-vault');
    console.log(`  ✓ ${r.files.length} contracts in contracts/src/:`);
    for (const f of r.files) console.log(`    - ${f}`);
    console.log('  ✓ Deploy script: contracts/deploy.js');
    console.log('\n  Next: dotname deploy');
    break;
  }
  case 'deploy':
    console.log('  dotname deploy — Base Sepolia');
    console.log('  > npx hardhat run contracts/deploy.js --network base-sepolia');
    console.log('  Set BASESEP_RPC_URL + PRIVATE_KEY in .env');
    break;
  case 'register':
    console.log(`  dotname register ${arg} — ENS\n  name.base.eth → profile contract`);
    break;
  case 'demo':
    console.log('  dotname demo\n');
    console.log('  [1/4] Spec: write .dog → dotdog compile → .dag');
    console.log('  [2/4] Generate: .dag → Solidity');
    const r2 = generate('.', 'yield-vault');
    console.log(`  [3/4] Deploy: ${r2.files.length} contracts → Base Sepolia`);
    console.log('  [4/4] Register: name.base.eth → ENS resolution');
    console.log('\n  ✓ Pipeline ready.');
    break;
  default:
    console.log(`dotname — spec-first onchain identity

  dotname generate       Generate Solidity from .dag
  dotname deploy         Deploy to Base Sepolia
  dotname register name  Register name.base.eth
  dotname demo           Full pipeline demo

Built on dotdog · Deploy on Base · Resolve via ENS`);
}
